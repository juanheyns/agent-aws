;; agent-aws step 1: protect credentials and known persistence/launch paths.
;; Network access remains open until the separate egress-lock step.
(version 1)
(allow default)

(deny file-read* file-write*
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.agent-aws"))
  (subpath (param "HOME_AWS_DIR"))
  (subpath (param "AGENT_DIR")))

(deny file-read*
  (regex #"/\.aws/sso/cache/.*\.json$")
  (regex #"/\.aws/credentials$"))

;; Startup, executable, installation and ancestor write denies are generated
;; by build_sandbox_argv_darwin; this static profile supplies the base rules.

;; Hide other runs, including paths reached through macOS's /tmp symlink.
(deny file-read* file-write* (regex #"^/(private/)?tmp/agent-aws\."))
;; Permit pathname lookup so shell globs do not silently omit other runs.
;; Their file contents and directory listings remain unreadable.
(allow file-read-metadata
  (regex #"^/(private/)?tmp/agent-aws\.[^/]+(/(credentials|config))?$"))
(allow file-read* file-write* (subpath (param "CREDS_DIR")))

(deny file-mount)
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.coreservices.quarantine-resolver"))
(deny process-exec
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/bin/launchctl"))
