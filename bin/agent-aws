#!/usr/bin/env -S python3 -I
"""agent-aws — run CLI agents against AWS with scoped read-only roles.

Layered design:
  1. agent-aws init bootstraps ~/.agent-aws/config.json with one or more
     read-only profiles selected from ~/.aws/config. Admin-equivalent role
     names are rejected at init and on every run.
  2. agent-aws run mints short-lived STS creds for each configured profile,
     writes them to a per-invocation tempdir, and execs the requested
     command inside sandbox-exec. The sandbox denies file-read* on ~/.aws/,
     so even if the wrapped process tries to mint admin creds from the SSO
     cache, the read fails before any AWS API call can happen.
"""

import argparse
import configparser
import errno
import glob
import json
import os
import re
import shlex
import shutil
import site
import stat
import subprocess
import sys
import tempfile
import time
from datetime import datetime
from pathlib import Path

try:
    import tomllib
except ImportError:  # Python < 3.11
    tomllib = None

__version__ = "1.0.0"

HOME = Path.home()
AWS_DIR = HOME / ".aws"
AWS_CONFIG = AWS_DIR / "config"
AWS_SSO_CACHE = AWS_DIR / "sso" / "cache"

AGENT_DIR = HOME / ".agent-aws"
AGENT_CONFIG = AGENT_DIR / "config.json"

SCRIPT_DIR = Path(__file__).resolve().parent
SANDBOX_PROFILE = SCRIPT_DIR.parent / "share" / "agent-aws" / "agent-aws.sb"

ADMIN_BLOCKLIST = ("admin", "poweruser", "fullaccess")
DEFAULT_ALLOWED_ROLES = ("ai-agent", "ReadOnlyAccess")
STARTUP_PATHS = (
    ".zshrc", ".zprofile", ".zshenv", ".bashrc", ".bash_profile", ".profile",
    ".zlogin", ".zlogout", ".bash_login", ".bash_logout",
    "Library/LaunchAgents", ".config/brnr",
    ".config/systemd/user", ".config/autostart",
    # Configuration that later unsandboxed git, ssh and Claude Code sessions
    # execute commands from (fsmonitor/credential helpers, ProxyCommand, hooks).
    ".gitconfig", ".config/git",
    ".ssh/config", ".ssh/rc", ".ssh/authorized_keys", ".ssh/authorized_keys2",
    ".claude/settings.json", ".claude/settings.local.json",
    # User-level agent instructions that later sessions load (#8). The agents'
    # own config and state (~/.claude.json, ~/.claude/projects, plugins,
    # ~/.codex/config.toml, auth.json, sessions) stay writable.
    ".claude/CLAUDE.md", ".claude/agents", ".claude/commands", ".claude/skills",
    ".codex/AGENTS.md", ".codex/AGENTS.override.md",
    # Shell and tool startup code that later unsandboxed shells and tools run
    # (#9). Only files that the tools do not write in normal use: fish
    # fish_variables (`set -U`), the oh-my-zsh checkout and cache, nvim
    # lazy-lock.json and IPython history stay writable.
    ".config/fish/config.fish", ".config/fish/conf.d", ".config/fish/functions",
    ".config/fish/completions", ".oh-my-zsh/custom", ".zpreztorc", ".inputrc",
    ".npmrc", ".config/starship.toml", ".config/direnv",
    ".tmux.conf", ".config/tmux/tmux.conf",
    ".vimrc", ".config/nvim/init.lua", ".config/nvim/init.vim",
    ".ipython/profile_default/startup", ".ipython/profile_default/ipython_config.py",
)
# Linux: HOME-relative directories that are bound read-write instead of made
# a private skeleton, with their existing protected children bound read-only
# on top. Use it for a directory whose own files the agents replace by rename
# (~/.codex/config.toml). The directory and each existing protected child are
# mount points, so neither can be renamed or unlinked. Cost: a missing
# protected child can be created on the host. Not used (skeleton instead)
# when a protected child is a symlink. See linux_parent_binds().
LINUX_PARENT_BIND = (".codex",)
# Asked of the interpreter named by a Python `aws` script. -I -S: no site,
# user-site or working-directory code runs while answering.
PYTHON_PATHS_PROBE = (
    "import json, site, sys, sysconfig; print(json.dumps([sys.prefix, sys.base_prefix, "
    "sys.exec_prefix, sys.base_exec_prefix, site.getusersitepackages(), "
    "*site.getsitepackages(), *sysconfig.get_paths().values()]))"
)
PYTHON_NAMES = ("python", "pypy")
# pip/distlib write `#!/bin/sh` and this line when the interpreter path is
# longer than the kernel shebang limit or contains spaces.
TRAMPOLINE = "'''exec' "
INSTALL_DIR = SCRIPT_DIR.parent
# Git config targets (issue #6). Git stops at include depth 10; ssh at 16.
GIT_TIMEOUT = 10
GIT_INCLUDE_DEPTH = 10
SSH_INCLUDE_DEPTH = 16
# section -> variable names whose value is a command that a later,
# unsandboxed git runs. None: every variable in the section (pager.<cmd>,
# alias.<name>). Keys with a subsection (diff.<driver>.textconv) match by
# their section and last part. Not complete forever: new git releases add
# keys (check `git help config` for "command" when git is upgraded).
GIT_COMMAND_KEYS = {
    "core": {"fsmonitor", "sshcommand", "pager", "editor", "askpass", "gitproxy",
             "alternaterefscommand"},
    "credential": {"helper"},
    "sequence": {"editor"},
    "gpg": {"program", "defaultkeycommand"},
    "hook": {"command"},
    "interactive": {"difffilter"},
    "trailer": {"command", "cmd"},
    "remote": {"uploadpack", "receivepack"},
    "diff": {"external", "textconv", "command"},
    "filter": {"clean", "smudge", "process"},
    "merge": {"driver"},
    "mergetool": {"cmd", "path"},
    "difftool": {"cmd", "path"},
    "man": {"cmd", "path"},
    "browser": {"cmd", "path"},
    "sendemail": {"smtpserver", "sendmailcmd", "tocmd", "cccmd", "headercmd"},
    "uploadpack": {"packobjectshook"},
    "pager": None,
    "alias": None,
}
SSH_COMMAND_KEYWORDS = ("proxycommand", "localcommand", "knownhostscommand")
SSH_LIBRARY_KEYWORDS = ("pkcs11provider", "securitykeyprovider")
# Claude Code settings whose value is a shell command (besides hooks and
# statusLine.command).
CLAUDE_COMMAND_KEYS = ("apiKeyHelper", "awsAuthRefresh", "awsCredentialExport", "otelHeadersHelper")

IS_MACOS = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")


def die(msg, code=1):
    print(f"agent-aws: {msg}", file=sys.stderr)
    sys.exit(code)


def is_admin_role(role):
    role_lower = (role or "").lower()
    return any(b in role_lower for b in ADMIN_BLOCKLIST)


def load_config():
    # Check the opened inode, not a prior stat of a replaceable pathname.
    try:
        fd = os.open(AGENT_CONFIG, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd) as f:
            info = os.fstat(f.fileno())
            if not stat.S_ISREG(info.st_mode):
                die(f"config must be a regular file: {AGENT_CONFIG}")
            if info.st_uid != os.getuid():
                die(f"config must be owned by the current user: {AGENT_CONFIG}")
            if stat.S_IMODE(info.st_mode) != 0o600:
                die(f"config must have mode 0600: {AGENT_CONFIG}")
            raw = json.load(f)
    except FileNotFoundError:
        die(f"no config at {AGENT_CONFIG} — run `agent-aws init` first")
    except OSError as exc:
        if exc.errno == errno.ELOOP:
            die(f"config must not be a symlink: {AGENT_CONFIG}")
        die(f"cannot read config: {exc}")
    except ValueError as exc:
        die(f"invalid config JSON: {exc}")
    if not isinstance(raw, dict):
        die("config must be a JSON object")
    # In-memory migration: pre-multi-profile schema had account_id at the top
    # level. Wrap it as a single profile named "default" so the rest of the
    # code path is uniform. The on-disk file is rewritten on next `init`.
    if "profiles" not in raw and "account_id" in raw:
        raw = {"default_profile": "default", "profiles": {"default": raw},
               "allowed_roles": raw.get("allowed_roles", list(DEFAULT_ALLOWED_ROLES))}
    validate_config_shape(raw)
    return raw


def validate_config_shape(cfg):
    if not isinstance(cfg, dict) or not isinstance(cfg.get("profiles"), dict):
        die("config profiles must be an object")
    for name, profile in cfg["profiles"].items():
        if not isinstance(profile, dict):
            die(f"profile '{name}' must be an object")


def validate_roles(cfg):
    validate_config_shape(cfg)
    allowed = cfg.get("allowed_roles", list(DEFAULT_ALLOWED_ROLES))
    if not isinstance(allowed, list) or not all(isinstance(r, str) and r for r in allowed):
        die("allowed_roles must be a list of non-empty role names")
    for name, profile in cfg["profiles"].items():
        role = profile.get("role_name")
        if not isinstance(role, str) or not role:
            die(f"profile '{name}' has no valid role_name")
        if is_admin_role(role):
            die(f"refusing admin-equivalent role '{role}' for profile '{name}'")
        if role not in allowed:
            die(f"role '{role}' for profile '{name}' is not in allowed_roles; "
                "use `agent-aws init --role NAME` to approve a custom read-only role")


def preferred_role(src, sessions, profiles, tokens, aws_cli=None):
    """Prefer ai-agent when configured locally or returned by SSO; never log in."""
    session = sessions.get(src.get("sso_session"), {})
    account = src.get("sso_account_id")
    if any(p.get("sso_account_id") == account
           and p.get("sso_session") == src.get("sso_session")
           and p.get("sso_role_name") == "ai-agent" for p in profiles.values()):
        return "ai-agent"
    token = tokens.get(session.get("sso_start_url"))
    if token:
        result = subprocess.run([
            aws_cli or resolve_aws_cli(), "sso", "list-account-roles", "--account-id", account,
            "--access-token", token, "--region", session["sso_region"],
            "--output", "json",
        ], capture_output=True, text=True)
        if result.returncode:
            die("cannot discover account roles; use --role to select explicitly "
                "(no login was attempted)")
        if any(r.get("roleName") == "ai-agent"
               for r in json.loads(result.stdout).get("roleList", [])):
            return "ai-agent"
    else:
        print("agent-aws: no cached SSO token for role discovery; "
              "using the locally configured role", file=sys.stderr)
    return src.get("sso_role_name")


def parse_aws_config():
    if not AWS_CONFIG.exists():
        die(f"~/.aws/config not found at {AWS_CONFIG}")
    cp = configparser.ConfigParser()
    cp.read(AWS_CONFIG)
    profiles, sessions = {}, {}
    for section in cp.sections():
        if section.startswith("profile "):
            profiles[section[len("profile "):]] = dict(cp[section])
        elif section.startswith("sso-session "):
            sessions[section[len("sso-session "):]] = dict(cp[section])
    return profiles, sessions


def find_sso_tokens():
    """Return {startUrl: accessToken} for the freshest unexpired token per URL."""
    if not AWS_SSO_CACHE.exists():
        return {}
    now = time.time()
    best = {}
    for p in AWS_SSO_CACHE.glob("*.json"):
        try:
            data = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        url = data.get("startUrl")
        token = data.get("accessToken")
        exp = data.get("expiresAt")
        if not (url and token and exp):
            continue
        try:
            exp_ts = datetime.fromisoformat(exp.replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
        if exp_ts < now:
            continue
        if url not in best or exp_ts > best[url][1]:
            best[url] = (token, exp_ts)
    return {url: tok for url, (tok, _) in best.items()}


def derive_profile_entry(name, src, sessions):
    sess_name = src.get("sso_session")
    if not sess_name or sess_name not in sessions:
        die(f"profile '{name}' has no usable sso_session")
    sess = sessions[sess_name]
    role = src.get("sso_role_name")
    if is_admin_role(role):
        die(f"refusing admin-equivalent role '{role}' for profile '{name}'")
    return {
        "sso_session": sess_name,
        "sso_start_url": sess["sso_start_url"],
        "sso_region": sess["sso_region"],
        "account_id": src["sso_account_id"],
        "role_name": role,
        "default_region": src.get("region", sess["sso_region"]),
    }


def cmd_init(args):
    profiles, sessions = parse_aws_config()
    if not profiles:
        die("no profiles found in ~/.aws/config")

    eligible = {n: p for n, p in profiles.items()
                if not is_admin_role(p.get("sso_role_name"))}
    if not eligible:
        die("no non-admin profiles in ~/.aws/config — add a ReadOnlyAccess profile")

    if args.all:
        chosen = list(eligible)
    elif args.profile:
        chosen = list(args.profile)
        for n in chosen:
            if n in profiles and n not in eligible:
                die(f"refusing admin-equivalent profile '{n}'")
            if n not in profiles:
                die(f"profile '{n}' not found in ~/.aws/config")
    else:
        chosen = interactive_select(eligible)

    if args.role and is_admin_role(args.role):
        die(f"refusing admin-equivalent role '{args.role}'")
    aws_cli = resolve_aws_cli() if not args.role else None
    tokens = find_sso_tokens() if not args.role else {}
    new_profiles = {}
    for name in chosen:
        src = dict(eligible[name])
        src["sso_role_name"] = args.role or preferred_role(src, sessions, profiles, tokens, aws_cli)
        new_profiles[name] = derive_profile_entry(name, src, sessions)

    if args.default:
        if args.default not in new_profiles:
            die(f"--default '{args.default}' not in selected profiles")
        default = args.default
    else:
        default = chosen[0]
        if len(chosen) > 1:
            print(f"agent-aws: using '{default}' as default profile (override with --default)", file=sys.stderr)

    allowed = list(DEFAULT_ALLOWED_ROLES)
    if args.role and args.role not in allowed:
        allowed.append(args.role)
    cfg = {"default_profile": default, "allowed_roles": allowed, "profiles": new_profiles}
    validate_roles(cfg)
    AGENT_DIR.mkdir(mode=0o700, exist_ok=True)
    # Atomic replacement never follows an existing config symlink and never
    # leaves a partially written or world-readable config behind.
    fd, tmp = tempfile.mkstemp(prefix=".config.", dir=AGENT_DIR)
    try:
        with os.fdopen(fd, "w") as f:
            os.fchmod(f.fileno(), 0o600)
            f.write(json.dumps(cfg, indent=2) + "\n")
        os.replace(tmp, AGENT_CONFIG)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

    print(f"wrote {AGENT_CONFIG}")
    print(f"  default: {default}")
    for n, p in new_profiles.items():
        marker = "*" if n == default else " "
        print(f"  {marker} {n}  ({p['role_name']} @ {p['account_id']})")


def interactive_select(eligible):
    print("Read-only profiles in ~/.aws/config:")
    names = list(eligible)
    for i, n in enumerate(names, 1):
        p = eligible[n]
        print(f"  {i}. {n}  ({p.get('sso_role_name')} @ {p.get('sso_account_id')})")
    sel = input("Select (comma-separated numbers, or 'all'): ").strip()
    if sel.lower() == "all":
        return names
    chosen = []
    try:
        for s in sel.split(","):
            chosen.append(names[int(s.strip()) - 1])
    except (ValueError, IndexError):
        die("invalid selection")
    if not chosen:
        die("no profiles selected")
    return chosen


def cmd_login(args):
    cfg = load_config()
    sessions = sorted({p["sso_session"] for p in cfg["profiles"].values()})
    if args.session:
        if args.session not in sessions:
            die(f"session '{args.session}' not used by any configured profile")
        sessions = [args.session]
    rc = 0
    for s in sessions:
        if len(sessions) > 1:
            print(f"=== aws sso login --sso-session {s} ===")
        r = subprocess.run(["aws", "sso", "login", "--sso-session", s])
        if r.returncode != 0:
            rc = r.returncode
    sys.exit(rc)


def mint_role_creds(token, profile_cfg, aws_cli):
    r = subprocess.run(
        [
            aws_cli, "sso", "get-role-credentials",
            "--role-name", profile_cfg["role_name"],
            "--account-id", profile_cfg["account_id"],
            "--access-token", token,
            "--region", profile_cfg["sso_region"],
            "--output", "json",
        ],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        die(f"sso get-role-credentials failed for "
            f"{profile_cfg['role_name']}@{profile_cfg['account_id']}: {r.stderr.strip()}")
    return json.loads(r.stdout)["roleCredentials"]


def default_path():
    parts = ["/usr/local/bin", "/usr/bin", "/bin"]
    if IS_MACOS:
        parts.append("/opt/homebrew/bin")
    if IS_LINUX:
        parts.extend(["/usr/local/sbin", "/usr/sbin"])
    # ~/.local/bin is the standard install location for tools like the
    # Claude Code CLI on both macOS and Linux. Include it in the fallback
    # so the sandbox PATH is sane even if the parent shell didn't export one.
    parts.append(str(HOME / ".local" / "bin"))
    return ":".join(parts)


def check_sandbox_tool():
    if IS_MACOS:
        if not shutil.which("sandbox-exec"):
            die("sandbox-exec not found (should be built-in on macOS)")
        if not SANDBOX_PROFILE.exists():
            die(f"sandbox profile not found at {SANDBOX_PROFILE}")
    elif IS_LINUX:
        if not shutil.which("bwrap"):
            die("bwrap not found — install bubblewrap "
                "(apt install bubblewrap / dnf install bubblewrap / pacman -S bubblewrap)")
    else:
        die(f"unsupported platform: {sys.platform}")


def executable_path():
    return os.environ.get("PATH") or default_path()


def resolve_aws_cli():
    # Pin before reading SSO tokens. The child sandbox protects every PATH
    # directory, its ancestors, and the resolved CLI installation against
    # poisoning a later invocation (including an earlier, empty PATH entry).
    path = shutil.which("aws", path=executable_path())
    if not path:
        die("aws CLI not found in PATH")
    return str(Path(path).resolve())


def is_python_name(path):
    return Path(path).name.startswith(PYTHON_NAMES)


def env_command(words):
    """Return (program, search path) for the arguments of an `env` shebang."""
    search = executable_path()
    words = list(words)
    while words:
        word = words.pop(0)
        if word == "--":
            break
        if word.startswith("--"):
            name, eq, value = word.partition("=")
            if name in ("--unset", "--chdir") and not eq and words:
                value = words.pop(0)
            if name == "--unset" and value == "PATH" or name == "--ignore-environment":
                search = os.defpath
            elif name == "--split-string" and eq:
                words[:0] = value.split()
            continue
        if word == "-":
            search = os.defpath
            continue
        if word.startswith("-"):
            # A cluster of short options; u, C and P take an argument and S
            # starts the split command string (GNU and BSD env).
            for index, option in enumerate(word[1:], 2):
                if option == "i":
                    search = os.defpath
                elif option in "uCP":
                    value = word[index:] or (words.pop(0) if words else "")
                    if option == "u" and value == "PATH":
                        search = os.defpath
                    elif option == "P":
                        search = value
                    break
                elif option == "S":
                    words[:0] = word[index:].split()
                    break
            continue
        if "=" in word:
            name, _, value = word.partition("=")
            if name == "PATH":
                search = value
            continue
        return word, search
    return (words[0] if words else None), search


def script_python(path):
    """Return the Python interpreter that runs a script, or None.

    Follows a direct shebang, `env` (with its options), and the pip/distlib
    `#!/bin/sh` + `'''exec' <python>` trampoline. Warns when a Python-like
    interpreter is named but cannot be followed.
    """
    try:
        with open(path, "rb") as f:
            first = f.readline(512).decode(errors="replace")
            second = f.readline(4096).decode(errors="replace")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    words = first[2:].split()
    python_like = any(name in first for name in PYTHON_NAMES)
    if words and Path(words[0]).name == "env":
        command, search = env_command(words[1:])
        if command:
            python_like = is_python_name(command)
            words = [(shutil.which(command, path=search) or "") if python_like else command]
        else:
            words = []
    elif words and Path(words[0]).name == "sh" and second.startswith(TRAMPOLINE):
        python_like = True
        try:
            words = shlex.split(second[len(TRAMPOLINE):])[:1]
        except ValueError:
            words = []
    if words and words[0] and os.path.isabs(words[0]) and is_python_name(words[0]):
        return words[0]
    if python_like:
        print(f"agent-aws: warning: cannot follow the Python interpreter of the AWS CLI "
              f"script {path} ({first.strip()}); its installation is not protected "
              "(see https://github.com/juanheyns/agent-aws/issues/12)", file=sys.stderr)
    return None


def python_paths(python):
    # A different interpreter (e.g. `pip install --user awscli`) loads its own
    # prefix, site-packages and user site. Fail closed if they are unknown.
    try:
        result = subprocess.run([python, "-I", "-S", "-c", PYTHON_PATHS_PROBE],
                                capture_output=True, text=True, timeout=30)
        if result.returncode:
            raise ValueError(result.stderr)
        return [Path(path) for path in json.loads(result.stdout) if path]
    except (OSError, subprocess.SubprocessError, TypeError, ValueError):
        die(f"cannot determine the Python paths of the AWS CLI interpreter {python}")


def venv_paths(python):
    """Protect a venv that the interpreter (lexical or resolved path) runs in.

    Before Python 3.11, `-I -S` makes a venv interpreter report the base
    install, because site.py sets sys.prefix to the venv. site.venv() looks
    for pyvenv.cfg next to the executable or one level up, and uses the
    executable's parent's parent as the venv prefix. The markers are always
    protected so that a run cannot turn a directory into a venv.
    """
    paths = set()
    for executable in (Path(python).absolute(), Path(python).resolve()):
        root = executable.parent.parent
        markers = (executable.parent / "pyvenv.cfg", root / "pyvenv.cfg")
        paths.update(markers)
        if any(marker.is_file() for marker in markers) and root != HOME and root not in HOME.parents:
            paths.add(root)
    return paths


def warn(msg):
    print(f"agent-aws: warning: {msg}", file=sys.stderr)


def home_path(text):
    """Expand `~/` and `~user/` as git and ssh do; other text is unchanged."""
    if text == "~" or text.startswith("~/"):
        return HOME / text[2:]
    return Path(os.path.expanduser(text) if text.startswith("~") else text)


def command_program(command):
    """Return the program of a configured command if it is an absolute or ~ path.

    Takes the first word (shlex), after a git `!` and a leading `exec`. Bare
    names resolve through PATH, which is protected. Other shell syntax
    (`sh -c '...'`, functions, variables) cannot be resolved: None.
    """
    try:
        words = shlex.split(command)
    except ValueError:
        return None
    if words and words[0].startswith("!"):
        words[0] = words[0][1:]
        if not words[0]:
            words.pop(0)
    if words and words[0] == "exec":
        words.pop(0)
    path = home_path(words[0]) if words else None
    return Path(os.path.normpath(path)) if path and path.is_absolute() else None


def usable_targets(paths):
    # Never protect HOME or an ancestor (#5 guard), and skip paths below an
    # existing file: they cannot exist, and the Linux skeleton needs dirs.
    return {path for path in paths
            if path.is_absolute() and path != HOME and path not in HOME.parents
            and not any(parent.exists() and not parent.is_dir() for parent in path.parents)}


def git_config_entries(git, args, cwd, env, show_origin=False):
    """Return ([(origin, key, value)], None) from `git config -z`, or (None, error)."""
    try:
        result = subprocess.run([git, "--no-pager", "config", "-z", *args], cwd=cwd, env=env,
                                stdin=subprocess.DEVNULL, capture_output=True, timeout=GIT_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)
    if result.returncode:
        return None, os.fsdecode(result.stderr).strip() or f"exit {result.returncode}"
    items = os.fsdecode(result.stdout).split("\0")[:-1]
    pairs = zip(items[0::2], items[1::2]) if show_origin else ((None, item) for item in items)
    entries = []
    for origin, item in pairs:
        key, newline, value = item.partition("\n")
        entries.append((origin, key, value if newline else None))
    return entries, None


def include_targets(config_file, value):
    # Git resolves a relative include path against the including file's
    # directory. %(prefix)/ is relative to git's installation prefix.
    if value.startswith("%(prefix)/"):
        return []
    target = home_path(value)
    bases = {config_file.parent, config_file.resolve().parent}
    return [Path(os.path.normpath(target if target.is_absolute() else base / target))
            for base in bases]


def git_config_paths():
    """Files, hook directories and helper programs that global git config names.

    Every file is read with --no-includes and every include.path and
    includeIf.*.path is followed, whatever its condition. Git itself also
    lists the files it includes from a cwd outside any repository.
    `git config --list` reads config only: it runs no helper, pager or hook.
    """
    files = {HOME / ".gitconfig", HOME / ".config/git/config"}
    paths = set()
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg and os.path.isabs(xdg):
        paths.add(Path(xdg) / "git")
        files.add(Path(xdg) / "git/config")
    # The files that `git config --global` reads in this environment.
    effective = files - {HOME / ".config/git/config"} if xdg and os.path.isabs(xdg) else set(files)
    if os.environ.get("GIT_CONFIG_GLOBAL"):
        effective = {Path(os.path.abspath(home_path(os.environ["GIT_CONFIG_GLOBAL"])))}
        files |= effective
    paths.update(files)
    git = shutil.which("git", path=executable_path())
    if not git:
        if any(path.exists() for path in files):
            warn("git not found in PATH; git include targets, core.hooksPath and helper "
                 "programs are not protected")
        return usable_targets(paths)
    failures = []
    queue = [(path, 0) for path in sorted(files)]
    with tempfile.TemporaryDirectory(prefix="agent-aws-git.") as cwd:
        env = {"HOME": str(HOME), "PATH": executable_path(), "LC_ALL": "C",
               "GIT_CONFIG_NOSYSTEM": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_PAGER": "cat",
               "GIT_CEILING_DIRECTORIES": str(Path(cwd).resolve().parent)}
        if any(path.is_file() for path in effective):
            entries, error = git_config_entries(
                git, ["--global", "--list", "--show-origin", "--includes"], cwd,
                dict(env, **{name: os.environ[name] for name in ("GIT_CONFIG_GLOBAL", "XDG_CONFIG_HOME")
                             if os.environ.get(name)}), show_origin=True)
            if entries is None:
                failures.append(("--global", error))
            queue += [(Path(origin[5:]), 0) for origin, _, _ in entries or ()
                      if origin.startswith("file:") and os.path.isabs(origin[5:])]
        # Each file alone: the global config does not apply to these reads.
        env["GIT_CONFIG_GLOBAL"] = os.devnull
        seen = set()
        while queue:
            path, depth = queue.pop(0)
            if path in seen or depth > GIT_INCLUDE_DEPTH:
                continue
            seen.add(path)
            paths.add(path)
            if not path.is_file():
                continue
            entries, error = git_config_entries(git, ["--file", str(path), "--no-includes", "--list"],
                                                cwd, env)
            if entries is None:
                failures.append((path, error))
                continue
            for _, key, value in entries:
                if not value:
                    continue
                section, name = key.split(".", 1)[0], key.rsplit(".", 1)[-1]
                if section in ("include", "includeif") and name == "path":
                    queue += [(target, depth + 1) for target in include_targets(path, value)]
                elif key in ("core.hookspath", "init.templatedir"):
                    # Hook directories: `git init` copies hooks from the
                    # template directory. A relative hooksPath is relative
                    # to each repository.
                    target = home_path(value)
                    if target.is_absolute():
                        paths.add(Path(os.path.normpath(target)))
                elif section in GIT_COMMAND_KEYS and (GIT_COMMAND_KEYS[section] is None
                                                      or name in GIT_COMMAND_KEYS[section]):
                    program = command_program(value)
                    if program:
                        paths.add(program)
    for what, error in failures:
        warn(f"cannot read git config {what} ({error}); its include targets, core.hooksPath, "
             "init.templateDir and helper programs are not protected")
    return usable_targets(paths)


SSH_LINE = re.compile(r"\s*([A-Za-z][A-Za-z0-9]*)(?:\s*=\s*|\s+)(.*)")
GLOB_MAGIC = re.compile(r"[*?[]")


def ssh_config_paths():
    """Include targets and programs that ~/.ssh/config names (a partial parse).

    Parsed: Include (~, relative to ~/.ssh, globs; recursively and whatever
    the Host/Match block), the first word of ProxyCommand, LocalCommand,
    KnownHostsCommand and Match [!]exec when it is an absolute or ~ path, and
    PKCS11Provider / SecurityKeyProvider libraries. `ssh -G` is not used: it
    evaluates `Match exec`, so it runs commands.
    """
    ssh_dir = HOME / ".ssh"
    paths = set()
    queue = [(ssh_dir / "config", 0)]
    seen = set()
    while queue:
        path, depth = queue.pop(0)
        if path in seen or depth > SSH_INCLUDE_DEPTH:
            continue
        seen.add(path)
        paths.add(path)
        try:
            if not path.is_file():
                continue
            with open(path, errors="replace") as f:
                text = f.read(1 << 20)
        except OSError:
            continue
        for line in text.splitlines():
            match = SSH_LINE.match(line)
            if not match:
                continue
            keyword, args = match.group(1).lower(), match.group(2).strip()
            try:
                words = shlex.split(args)
            except ValueError:
                continue
            programs = []
            if keyword == "include":
                for word in words:
                    pattern = home_path(word)
                    pattern = Path(os.path.normpath(pattern if pattern.is_absolute()
                                                    else ssh_dir / pattern))
                    if not GLOB_MAGIC.search(str(pattern)):
                        queue.append((pattern, depth + 1))
                        continue
                    queue += [(Path(name), depth + 1) for name in sorted(glob.glob(str(pattern)))]
                    # Protect the directory above the first glob part, so that
                    # new matches cannot be planted (not ~/.ssh: known_hosts).
                    fixed = Path(pattern.anchor)
                    for part in pattern.parts[1:]:
                        if GLOB_MAGIC.search(part):
                            break
                        fixed /= part
                    if fixed != ssh_dir:
                        paths.add(fixed)
            elif keyword in SSH_COMMAND_KEYWORDS:
                programs.append(args)
            elif keyword == "match":
                programs += [command for criterion, command in zip(words, words[1:])
                             if criterion.lower() in ("exec", "!exec")]
            elif keyword in SSH_LIBRARY_KEYWORDS and words:
                programs.append(shlex.quote(words[0]))
            paths.update(filter(None, map(command_program, programs)))
    return usable_targets(paths)


def load_agent_config(path, parse):
    """Parsed config file, or None if it is missing or cannot be parsed (warns)."""
    try:
        if not path.is_file():
            return None
        return parse(path.read_bytes())
    except (OSError, ValueError, RecursionError) as exc:
        warn(f"cannot parse {path} ({exc}); the programs it names are not protected")
        return None


def mcp_server_programs(servers):
    if not isinstance(servers, dict):
        return []
    return [server.get("command") for server in servers.values() if isinstance(server, dict)]


def agent_config_paths():
    """Programs that user-level Claude Code and Codex config names (issue #8).

    Read: hook commands, statusLine.command and helper commands in
    ~/.claude/settings.json and settings.local.json; mcpServers.*.command in
    ~/.claude.json (top level and projects.*); mcp_servers.*.command and
    notify[0] in ~/.codex/config.toml. Only an absolute or ~ program is kept
    (for a shell command, its first word, with a leading $HOME as ~). Nothing
    is executed. The config files stay writable: the agents write them.
    """
    commands, programs = [], []
    for name in ("settings.json", "settings.local.json"):
        settings = load_agent_config(HOME / ".claude" / name, json.loads)
        if not isinstance(settings, dict):
            continue
        hooks = settings.get("hooks")
        for groups in hooks.values() if isinstance(hooks, dict) else ():
            for group in groups if isinstance(groups, list) else ():
                entries = group.get("hooks") if isinstance(group, dict) else None
                commands += [hook.get("command") for hook in entries or ()
                             if isinstance(entries, list) and isinstance(hook, dict)]
        status = settings.get("statusLine")
        if isinstance(status, dict):
            commands.append(status.get("command"))
        commands += [settings.get(key) for key in CLAUDE_COMMAND_KEYS]
    state = load_agent_config(HOME / ".claude.json", json.loads)
    if isinstance(state, dict):
        programs += mcp_server_programs(state.get("mcpServers"))
        projects = state.get("projects")
        for project in projects.values() if isinstance(projects, dict) else ():
            if isinstance(project, dict):
                programs += mcp_server_programs(project.get("mcpServers"))
    codex = HOME / ".codex/config.toml"
    if tomllib is None:
        if codex.is_file():
            warn(f"tomllib needs Python 3.11+; the programs that {codex} names are not protected")
    else:
        config = load_agent_config(codex, lambda data: tomllib.loads(data.decode()))
        if isinstance(config, dict):
            programs += mcp_server_programs(config.get("mcp_servers"))
            notify = config.get("notify")
            if isinstance(notify, list) and notify:
                programs.append(notify[0])
    # A shell command expands $HOME (also "$HOME"/x); an MCP or notify
    # program is one argv word.
    paths = {command_program(re.sub(r"^([\"']?)\$(HOME|\{HOME\})/", r"\1~/",
                                    re.sub(r'^"\$(HOME|\{HOME\})"/', "~/", command)))
             for command in commands if isinstance(command, str)}
    paths.update(command_program(shlex.quote(program))
                 for program in programs if isinstance(program, str) and program)
    return usable_targets(paths - {None})


def config_targets():
    """Files and programs that the protected git, ssh (#6) and agent (#8) config refer to."""
    return git_config_paths() | ssh_config_paths() | agent_config_paths()


def protected_paths(targets=None):
    paths = {HOME / path for path in STARTUP_PATHS}
    paths.update((INSTALL_DIR, AWS_DIR, AGENT_DIR))
    # -I prevents user-site startup code; also prevent planting it for other
    # unsandboxed Python entry points using this interpreter.
    user_sites = site.getusersitepackages()
    if isinstance(user_sites, str):
        user_sites = [user_sites]
    paths.update(Path(path) for path in user_sites)
    # -I still loads installation-site .pth files. Homebrew can place these
    # outside sys.prefix, so enumerate them rather than infer their location.
    paths.update(Path(path) for path in site.getsitepackages())
    paths.update(Path(part or os.curdir).absolute() for part in executable_path().split(os.pathsep))
    # Preserve the lexical launcher path as well as its symlink target.
    paths.update((Path(__file__).absolute(), Path(sys.argv[0]).absolute(),
                  Path(sys.executable).absolute()))
    for name in ("agent-aws", "python3", "aws"):
        executable = shutil.which(name, path=executable_path())
        if executable:
            path = Path(executable).absolute()
            paths.add(path)
            # CLI/Python entry points can load sibling modules or libraries.
            # Protect their installation prefix, not just the executable inode.
            if name in ("aws", "python3"):
                prefix = path.resolve().parent.parent
                paths.add(prefix if prefix != HOME else path.resolve().parent)
    paths.update((Path(sys.prefix), Path(sys.base_prefix)))
    paths.update(config_targets() if targets is None else targets)
    # The file that $PYTHONSTARTUP names runs in every interactive Python (#9).
    startup = os.environ.get("PYTHONSTARTUP", "")
    if os.path.isabs(startup):
        paths.update(usable_targets({Path(startup)}))
    aws = shutil.which("aws", path=executable_path())
    python = aws and script_python(Path(aws).resolve())
    if python:
        paths.add(Path(python))
        paths.update(venv_paths(python))
        paths.update(path for path in python_paths(python) if path.is_absolute()
                     and path != HOME and path not in HOME.parents)
    # Homebrew prefixes are user-writable. PATH symlinks, interpreters and the
    # libraries they load resolve into Cellar/ and opt/, so protect every entry
    # except var/ (service data such as databases and logs).
    candidates = {parent for path in paths for parent in (path, *path.parents)}
    for prefix in sorted(candidates):
        if prefix != HOME and prefix not in HOME.parents and (prefix / "Cellar").is_dir():
            try:
                paths.update(child for child in prefix.iterdir() if child.name != "var")
            except OSError as exc:
                die(f"cannot list the Homebrew prefix {prefix}: {exc}")
    return paths | {path.resolve() for path in paths}


def build_sandbox_argv_darwin(creds_dir, paths=None):
    paths = protected_paths() if paths is None else paths
    ancestors = {parent for path in paths for parent in path.parents}
    # Literal ancestor denies stop rename-and-restore attacks without denying
    # writes to ordinary siblings. JSON quoting also escapes Scheme strings.
    rules = ["(deny file-write*"]
    rules += [f"  (subpath {json.dumps(str(path), ensure_ascii=False)})" for path in sorted(paths)]
    rules += [f"  (literal {json.dumps(str(path), ensure_ascii=False)})" for path in sorted(ancestors)]
    rules.append(")")
    return [
        "sandbox-exec",
        "-D", f"HOME={HOME.resolve()}",
        "-D", f"CREDS_DIR={creds_dir.resolve()}",
        "-D", f"HOME_AWS_DIR={AWS_DIR.resolve()}",
        "-D", f"AGENT_DIR={AGENT_DIR.resolve()}",
        "-p", SANDBOX_PROFILE.read_text() + "\n" + "\n".join(rules),
    ]


def linux_parent_binds(protected):
    """LINUX_PARENT_BIND directories that linux_home_mounts() binds read-write.

    Only a real directory (not a symlink) whose protected paths below it are
    all STARTUP_PATHS direct children, none of them a symlink (existing or
    dangling). Any other protected path below it (a config target) keeps the
    skeleton, so a missing program there cannot be created. A symlinked child
    (e.g. into a dotfiles repo) also keeps the skeleton: in a read-write bind
    its --ro-bind destination would be a host symlink, so bwrap would fail or
    rm plus a new file would persist on the host.
    """
    startup = {HOME / path for path in STARTUP_PATHS}
    binds = set()
    for name in LINUX_PARENT_BIND:
        directory = HOME / name
        if directory in protected or directory.is_symlink() or not directory.is_dir():
            continue
        below = [path for path in protected if directory in path.parents]
        if all(path in startup and path.parent == directory
               and not path.is_symlink() for path in below):
            binds.add(directory)
    return binds


def linux_home_mounts(protected=None):
    # Private skeletons prevent missing protected paths from being planted on
    # the host. Existing unprotected children (e.g. projects) remain writable.
    argv = []
    protected = protected_paths() if protected is None else protected
    parent_binds = linux_parent_binds(protected)
    private = {AWS_DIR, AGENT_DIR}
    containers = {HOME}
    containers.update(parent for path in protected for parent in path.parents
                      if HOME in parent.parents)

    def mirror(directory):
        argv.extend(["--tmpfs", str(directory)])
        if not directory.exists():
            return
        for child in sorted(directory.iterdir()):
            if child in private:
                continue
            if child in protected:
                argv.extend(["--ro-bind", str(child.resolve()), str(child)])
            elif child in parent_binds:
                # Mount points: the directory and its existing protected
                # children cannot be renamed or unlinked from the run.
                argv.extend(["--bind", str(child), str(child)])
                for path in sorted(path for path in protected
                                   if path.parent == child and path.exists()):
                    argv.extend(["--ro-bind", str(path.resolve()), str(path)])
            elif child in containers:
                mirror(child)
            elif child.is_symlink():
                argv.extend(["--symlink", os.readlink(child), str(child)])
            else:
                argv.extend(["--bind", str(child), str(child)])
        # Missing children are private to this skeleton; no host files are
        # created just to provide bind-mount destinations.

    if HOME in protected:
        argv += ["--ro-bind", str(HOME), str(HOME)]
    else:
        mirror(HOME)
    for path in sorted(private | {p.resolve() for p in private}):
        argv += ["--tmpfs", str(path), "--remount-ro", str(path)]
    # Include targets with symlinked ancestors, not only final-component links.
    for path in sorted(protected - private):
        if path.exists() and path.resolve() != path:
            argv += ["--ro-bind", str(path.resolve()), str(path.resolve())]
    return argv


def linux_target_skeletons(protected, targets):
    """Directories that linux_home_mounts() makes private skeletons only
    because a git/ssh (#6) or agent (#8) config target is below them.

    Every directory between HOME and a target is a skeleton (also when the
    target is missing): new top-level entries in it are lost when the run
    ends, and its existing entries are mount points (no rename or unlink).
    """
    targets = set(targets) | {path.resolve() for path in targets}

    def containers(paths):
        return {parent for path in paths for parent in path.parents if HOME in parent.parents}

    others = set(protected) - targets
    skeletons = (containers(targets) - (containers(others) - linux_parent_binds(others))
                 - linux_parent_binds(protected))
    # A directory below a protected path is read-only, not a skeleton.
    return sorted(path for path in skeletons
                  if not any(part in protected for part in (path, *path.parents)))


def linux_skeleton_note(protected, targets):
    skeletons = linux_target_skeletons(protected, targets)
    if skeletons:
        names = ", ".join(f"~/{path.relative_to(HOME)}" for path in skeletons)
        print("agent-aws: Linux: new top-level entries in these directories are lost when "
              f"the run ends (they hold protected git/ssh/agent config targets): {names}",
              file=sys.stderr)


def build_sandbox_argv_linux(creds_dir, protected=None):
    return [
        "bwrap",
        "--ro-bind", "/usr", "/usr",
        "--ro-bind", "/etc", "/etc",
        "--ro-bind-try", "/bin", "/bin",
        "--ro-bind-try", "/sbin", "/sbin",
        "--ro-bind-try", "/lib", "/lib",
        "--ro-bind-try", "/lib64", "/lib64",
        "--ro-bind-try", "/opt", "/opt",
        "--proc", "/proc",
        "--dev", "/dev",
        "--tmpfs", "/tmp",
        *linux_home_mounts(protected),
        "--bind", str(creds_dir), str(creds_dir),
        "--ro-bind", str(INSTALL_DIR), str(INSTALL_DIR),
        "--die-with-parent",
        "--unshare-pid",
        "--unshare-ipc",
        "--unshare-uts",
        "--new-session",
        "--",
    ]


def build_sandbox_argv(creds_dir, protected=None):
    if IS_MACOS:
        return build_sandbox_argv_darwin(creds_dir, protected)
    if IS_LINUX:
        return build_sandbox_argv_linux(creds_dir, protected)
    die(f"unsupported platform: {sys.platform}")


def cmd_run(args):
    if args.cmd and args.cmd[0] == "--":
        args.cmd = args.cmd[1:]
    if not args.cmd:
        die("usage: agent-aws run [--profile NAME] -- <command> [args...]")
    check_sandbox_tool()
    if any(part in ("", ".") for part in executable_path().split(os.pathsep)):
        print("agent-aws: warning: empty or dot PATH entries protect the current "
              "directory against writes; use absolute PATH entries to keep it writable",
              file=sys.stderr)

    cfg = load_config()
    validate_roles(cfg)  # Validate all profiles, even when --profile selects only one.
    profiles = cfg["profiles"]
    if not profiles:
        die("no profiles configured — run `agent-aws init`")

    if args.profile:
        if args.profile not in profiles:
            die(f"profile '{args.profile}' not configured (run `agent-aws init`)")
        active = {args.profile: profiles[args.profile]}
        active_default = args.profile
    else:
        active = profiles
        active_default = cfg.get("default_profile") or next(iter(profiles))

    aws_cli = resolve_aws_cli()
    AGENT_DIR.mkdir(mode=0o700, exist_ok=True)
    # The interpreter probe can fail closed (die). Decide on the protected
    # paths before any SSO token is read or handed to `aws`.
    targets = config_targets()
    protected = protected_paths(targets)
    if IS_LINUX:
        linux_skeleton_note(protected, targets)

    creds_dir = Path(tempfile.mkdtemp(prefix="agent-aws.", dir="/tmp"))
    cred_file = creds_dir / "credentials"
    cfg_file = creds_dir / "config"
    # From here on, any exit (die, exception, Ctrl-C) removes the credentials.
    try:
        rc = run_with_credentials(args, active, active_default, aws_cli, protected,
                                  creds_dir, cred_file, cfg_file)
    finally:
        for p in (cred_file, cfg_file):
            try:
                p.unlink()
            except FileNotFoundError:
                pass
        try:
            creds_dir.rmdir()
        except OSError:
            pass
    sys.exit(rc)


def run_with_credentials(args, active, active_default, aws_cli, protected,
                         creds_dir, cred_file, cfg_file):
    creds_dir.chmod(0o700)
    sandbox_argv = build_sandbox_argv(creds_dir, protected)

    tokens = find_sso_tokens()
    needed = {p["sso_start_url"] for p in active.values()}
    missing = needed - set(tokens.keys())
    if missing:
        die(f"no valid SSO token for: {', '.join(sorted(missing))} — run `agent-aws login`")

    cred_lines, cfg_lines = [], []
    for name, p in active.items():
        creds = mint_role_creds(tokens[p["sso_start_url"]], p, aws_cli)
        sections = [name, "default"] if name == active_default else [name]
        for sect in sections:
            cred_lines += [
                f"[{sect}]",
                f"aws_access_key_id = {creds['accessKeyId']}",
                f"aws_secret_access_key = {creds['secretAccessKey']}",
                f"aws_session_token = {creds['sessionToken']}",
                "",
            ]
            cfg_header = "default" if sect == "default" else f"profile {sect}"
            cfg_lines += [
                f"[{cfg_header}]",
                f"region = {p['default_region']}",
                "output = json",
                "",
            ]

    cred_file.write_text("\n".join(cred_lines))
    cfg_file.write_text("\n".join(cfg_lines))
    cred_file.chmod(0o600)
    cfg_file.chmod(0o600)

    env = {
        "HOME": str(HOME),
        "USER": os.environ.get("USER", ""),
        "LOGNAME": os.environ.get("LOGNAME", ""),
        "TERM": os.environ.get("TERM", "xterm-256color"),
        # PATH is inherited from the parent shell so binaries installed in
        # user-specific locations (~/.local/bin, ~/.claude/local, asdf/volta
        # shims, etc.) are discoverable. These directories and their ancestors
        # are write-protected to prevent poisoning the next unsandboxed run.
        "PATH": executable_path(),
        "LANG": os.environ.get("LANG", "en_US.UTF-8"),
        "AWS_CONFIG_FILE": str(cfg_file),
        "AWS_SHARED_CREDENTIALS_FILE": str(cred_file),
        "AWS_REGION": active[active_default]["default_region"],
        "AWS_DEFAULT_REGION": active[active_default]["default_region"],
        "AGENT_AWS_ACTIVE": "1",
        "AGENT_AWS_PROFILES": ",".join(active.keys()),
        "AGENT_AWS_DEFAULT_PROFILE": active_default,
    }

    return subprocess.run(sandbox_argv + args.cmd, env=env).returncode


def cmd_whoami(args):
    args.cmd = ["aws", "sts", "get-caller-identity"]
    cmd_run(args)


def cmd_status(args):
    cfg = load_config()
    tokens = find_sso_tokens()
    default = cfg.get("default_profile")
    print(f"Config:  {AGENT_CONFIG}")
    print(f"Default: {default}")
    print()
    name_w = max((len(n) for n in cfg["profiles"]), default=8)
    print(f"  {'profile':<{name_w}}  {'account':<14}  {'role':<22}  sso")
    print(f"  {'-'*name_w}  {'-'*14}  {'-'*22}  -------")
    for n, p in cfg["profiles"].items():
        sso_state = "ok" if p["sso_start_url"] in tokens else "expired"
        marker = "*" if n == default else " "
        print(f"{marker} {n:<{name_w}}  {p['account_id']:<14}  {p['role_name']:<22}  {sso_state}")


def main():
    p = argparse.ArgumentParser(
        prog="agent-aws",
        description="Run agents against AWS in a scoped read-only sandbox.",
    )
    p.add_argument("--version", action="version", version=f"agent-aws {__version__}")
    sub = p.add_subparsers(dest="sub", required=True)

    p_init = sub.add_parser("init", help="bootstrap ~/.agent-aws/config.json from ~/.aws/config")
    p_init.add_argument("--profile", action="append",
                        help="source profile name (repeatable)")
    p_init.add_argument("--all", action="store_true",
                        help="include every non-admin profile in ~/.aws/config")
    p_init.add_argument("--role", help="explicit read-only role for all selected profiles")
    p_init.add_argument("--default", help="profile to mark as default")
    p_init.set_defaults(func=cmd_init)

    p_login = sub.add_parser("login", help="aws sso login for configured sessions")
    p_login.add_argument("--session", help="log in to a specific sso-session only")
    p_login.set_defaults(func=cmd_login)

    p_run = sub.add_parser("run", help="run a command in the sandbox with read-only AWS creds")
    p_run.add_argument("--profile", help="restrict to a single profile (default: expose all)")
    p_run.add_argument("cmd", nargs=argparse.REMAINDER,
                       help="command and args (use -- to separate)")
    p_run.set_defaults(func=cmd_run)

    p_whoami = sub.add_parser("whoami", help="run `aws sts get-caller-identity` in the sandbox")
    p_whoami.add_argument("--profile", help="restrict to a single profile")
    p_whoami.set_defaults(func=cmd_whoami)

    p_status = sub.add_parser("status", help="show configured profiles and SSO freshness")
    p_status.set_defaults(func=cmd_status)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
